import "tfplan/v2" as tfplan

violations = func() {
    denies = []

    for tfplan.resource_changes as address, rc {
        if rc.type is "aws_kms_key" and rc.mode is "managed" {
            delete_planned = false
            if rc.change.actions {
                for rc.change.actions as action {
                    if action is "delete" {
                        delete_planned = true
                    }
                }
            }

            if not delete_planned and rc.change.after != null {
                enabled = lookup(rc.change.after, "is_enabled", true)
                if enabled {
                    append(denies, sprintf("aws_kms_key %q must be disabled (is_enabled = false).", [address]))
                }
            }
        }
    }

    return denies
}()

main = rule {
    length(violations) is 0
}
