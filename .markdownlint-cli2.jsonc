{
  "config": {
    "MD013": false,
    "MD024": false,
    "MD033": false,
    "MD034": false,
    "MD041": false,
  },
  "ignores": [
    ".terraform/**",
    ".venv/**",
    "__pycache__/**",
    ".pytest_cache/**",
    ".mypy_cache/**",
    ".ruff_cache/**",
    "node_modules/**",
    "dist/**",
    "build/**",
    ".git/**",
    ".external_modules/**",
    "infra/aws-core/terraform/modules/**/README.md",
    "infra/aws-core/terraform/environments/**/README.md",
  ],
}
